generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  name             String
  passwordHash     String
  role             Role           @default(LEARNER)
  emailVerified    Boolean        @default(false)
  verifyTokenHash  String?
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  phone            String?
  bio              String?
  avatarUrl        String?
  linkedinUrl      String?
  facebookUrl      String?
  instagramUrl     String?
  xUrl               String?
  twoFactorEnabled   Boolean        @default(false)
  twoFactorOtpHash   String?
  twoFactorOtpExpiry DateTime?
  isActive           Boolean        @default(true)
  deactivatedAt      DateTime?
  deactivationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  courses            Course[]
  notifications      Notification[]
  notificationPref   NotificationPreference?

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  courses   Course[]

  @@map("categories")
}

model Course {
  id           String         @id @default(uuid())
  title        String
  slug         String         @unique
  description  String
  thumbnail    String?
  level        CourseLevel    @default(BEGINNER)
  status       CourseStatus   @default(DRAFT)
  isFeatured   Boolean        @default(false)
  price        Decimal?       @db.Decimal(10, 2)
  categoryId   String
  instructorId String
  category     Category       @relation(fields: [categoryId], references: [id])
  instructor   User           @relation(fields: [instructorId], references: [id])
  modules      CourseModule[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId])
  @@index([instructorId])
  @@index([status])
  @@index([isFeatured])
  @@map("courses")
}

model CourseModule {
  id       String   @id @default(uuid())
  title    String
  position Int
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id       String       @id @default(uuid())
  title    String
  position Int
  duration Int?
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("lessons")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationSetupEmail   Boolean  @default(true)
  registrationSetupInApp   Boolean  @default(true)
  enrollmentConfirmEmail   Boolean  @default(true)
  enrollmentConfirmInApp   Boolean  @default(true)
  courseUpdatesEmail       Boolean  @default(true)
  courseUpdatesInApp       Boolean  @default(true)
  assessmentRemindersEmail Boolean  @default(false)
  assessmentRemindersInApp Boolean  @default(true)
  progressTrackingEmail    Boolean  @default(false)
  progressTrackingInApp    Boolean  @default(true)
  certificationAlertsEmail Boolean  @default(true)
  certificationAlertsInApp Boolean  @default(true)
  engagementPromptsEmail   Boolean  @default(true)
  engagementPromptsInApp   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("notification_preferences")
}

enum Role {
  LEARNER
  INSTRUCTOR
  ADMIN
}

enum NotificationType {
  COURSE_UPDATE
  ENROLLMENT
  PAYMENT
  SYSTEM
  ANNOUNCEMENT
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}
