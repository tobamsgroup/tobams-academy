generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  name             String
  passwordHash     String
  role             Role           @default(LEARNER)
  emailVerified    Boolean        @default(false)
  verifyTokenHash  String?
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  phone            String?
  bio              String?
  avatarUrl        String?
  linkedinUrl      String?
  facebookUrl      String?
  instagramUrl     String?
  xUrl               String?
  twoFactorEnabled   Boolean        @default(false)
  twoFactorOtpHash   String?
  twoFactorOtpExpiry DateTime?
  isActive           Boolean        @default(true)
  deactivatedAt      DateTime?
  deactivationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  courses            Course[]
  notifications      Notification[]
  notificationPref   NotificationPreference?
  enrollments        Enrollment[]
  quizAttempts       QuizAttempt[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  courses   Course[]

  @@map("categories")
}

model Course {
  id           String         @id @default(uuid())
  title        String
  slug         String         @unique
  description  String
  thumbnail    String?
  level        CourseLevel    @default(BEGINNER)
  status       CourseStatus   @default(DRAFT)
  isFeatured   Boolean        @default(false)
  price        Decimal?       @db.Decimal(10, 2)
  categoryId   String
  instructorId String
  category     Category       @relation(fields: [categoryId], references: [id])
  instructor   User           @relation(fields: [instructorId], references: [id])
  modules      CourseModule[]
  enrollments  Enrollment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId])
  @@index([instructorId])
  @@index([status])
  @@index([isFeatured])
  @@map("courses")
}

model CourseModule {
  id       String   @id @default(uuid())
  title    String
  position Int
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id         String         @id @default(uuid())
  title      String
  position   Int
  duration   Int?
  kind       LessonKind     @default(VIDEO)
  contentUrl String?
  contentKey String?
  moduleId   String
  module     CourseModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz       Quiz?
  progress   LessonProgress[]

  @@index([moduleId])
  @@map("lessons")
}

model Enrollment {
  id             String           @id @default(uuid())
  userId         String
  courseId       String
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  lastAccessedAt DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@map("enrollments")
}

model LessonProgress {
  id           String     @id @default(uuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@map("lesson_progress")
}

model Quiz {
  id              String         @id @default(uuid())
  lessonId        String         @unique
  timeLimit       Int
  passingScore    Int
  attemptsAllowed Int            @default(2)
  questionType    String         @default("Multiple Choice")
  lesson          Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions       QuizQuestion[]
  attempts        QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id       String       @id @default(uuid())
  quizId   String
  text     String
  position Int
  quiz     Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options  QuizOption[]

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  position   Int
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_options")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  score       Int
  isPassed    Boolean
  answers     Json
  completedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
  @@map("quiz_attempts")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationSetupEmail   Boolean  @default(true)
  registrationSetupInApp   Boolean  @default(true)
  enrollmentConfirmEmail   Boolean  @default(true)
  enrollmentConfirmInApp   Boolean  @default(true)
  courseUpdatesEmail       Boolean  @default(true)
  courseUpdatesInApp       Boolean  @default(true)
  assessmentRemindersEmail Boolean  @default(false)
  assessmentRemindersInApp Boolean  @default(true)
  progressTrackingEmail    Boolean  @default(false)
  progressTrackingInApp    Boolean  @default(true)
  certificationAlertsEmail Boolean  @default(true)
  certificationAlertsInApp Boolean  @default(true)
  engagementPromptsEmail   Boolean  @default(true)
  engagementPromptsInApp   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("notification_preferences")
}

enum Role {
  LEARNER
  INSTRUCTOR
  ADMIN
}

enum NotificationType {
  COURSE_UPDATE
  ENROLLMENT
  PAYMENT
  SYSTEM
  ANNOUNCEMENT
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonKind {
  VIDEO
  DOC
  PDF
  SCREEN
  QUIZ
  ASSESSMENT
}
