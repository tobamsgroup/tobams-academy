# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored by Next.js by default — never commit secrets.
# ---------------------------------------------------------------------------

# Postgres connection string used by Prisma (src/lib/prisma.ts).
DATABASE_URL="postgresql://user:password@localhost:5432/tobams_academy?schema=public"

# Frontend base URL used by client components to call the colocated API routes.
# Auth pages call `${NEXT_PUBLIC_API_URL}/auth/...` and the routes live under
# `/api/v1/auth/...`, so this MUST include the `/api/v1` suffix.
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# NextAuth v5. Generate one with: `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-long-random-string"
# Optional in dev; recommended in prod. NextAuth auto-detects otherwise.
# AUTH_URL="http://localhost:3000"

# JWT signing for the access/refresh tokens issued by /api/v1/auth/login.
JWT_SECRET="replace-me-jwt-access-secret"
JWT_REFRESH_SECRET="replace-me-jwt-refresh-secret"
# Optional overrides (defaults: 7h / 7d)
# ACCESS_TOKEN_EXPIRY="7h"
# REFRESH_TOKEN_EXPIRY="7d"

# Mailjet — used by lib/mail.ts to send verification & password-reset emails.
MAILJET_API_KEY=""
MAILJET_API_SECRET=""
MAILJET_FROM_EMAIL="no-reply@tobamsacademy.com"
MAILJET_FROM_NAME="Tobams Academy"

# Used inside email templates to build verify / reset links.
CLIENT_URL="http://localhost:3000"
