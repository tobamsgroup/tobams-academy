generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  name                     String
  passwordHash             String
  role                     Role                      @default(LEARNER)
  emailVerified            Boolean                   @default(false)
  verifyTokenHash          String?
  resetTokenHash           String?
  resetTokenExpiry         DateTime?
  phone                    String?
  bio                      String?
  avatarUrl                String?
  linkedinUrl              String?
  facebookUrl              String?
  instagramUrl             String?
  xUrl                     String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  twoFactorEnabled         Boolean                   @default(false)
  deactivatedAt            DateTime?
  deactivationReason       String?
  isActive                 Boolean                   @default(true)
  twoFactorOtpExpiry       DateTime?
  twoFactorOtpHash         String?
  courses                  Course[]
  enrollments              Enrollment[]
  notification_preferences notification_preferences?
  notifications            notifications[]
  quiz_attempts            quiz_attempts[]
   payments                Payment[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  courses   Course[]

  @@map("categories")
}

model Course {
  id           String         @id @default(uuid())
  title        String
  slug         String         @unique
  description  String
  thumbnail    String?
  level        CourseLevel    @default(BEGINNER)
  status       CourseStatus   @default(DRAFT)
  isFeatured   Boolean        @default(false)
  price        Decimal?       @db.Decimal(10, 2)
  categoryId   String
  instructorId String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  modules      CourseModule[]
  category     Category       @relation(fields: [categoryId], references: [id])
  instructor   User           @relation(fields: [instructorId], references: [id])
  enrollments  Enrollment[]
  payments     Payment[]

  @@index([categoryId])
  @@index([instructorId])
  @@index([status])
  @@index([isFeatured])
  @@map("courses")
}

model CourseModule {
  id       String   @id @default(uuid())
  title    String
  position Int
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id              String            @id @default(uuid())
  title           String
  position        Int
  duration        Int?
  moduleId        String
  kind            LessonKind        @default(VIDEO)
  contentUrl      String?
  contentKey      String?
  lesson_progress lesson_progress[]
  module          CourseModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizzes         quizzes?

  @@index([moduleId])
  @@map("lessons")
}

model Enrollment {
  id              String            @id @default(uuid())
  userId          String
  courseId        String
  enrolledAt      DateTime          @default(now())
  completedAt     DateTime?
  lastAccessedAt  DateTime?
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson_progress lesson_progress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@map("enrollments")
}

model lesson_progress {
  id           String     @id
  enrollmentId String
  lessonId     String
  completedAt  DateTime   @default(now())
  enrollments  Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessons      Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model notification_preferences {
  id                       String   @id
  userId                   String   @unique
  registrationSetupEmail   Boolean  @default(true)
  courseUpdatesEmail       Boolean  @default(true)
  courseUpdatesInApp       Boolean  @default(true)
  assessmentRemindersEmail Boolean  @default(false)
  assessmentRemindersInApp Boolean  @default(true)
  progressTrackingEmail    Boolean  @default(false)
  progressTrackingInApp    Boolean  @default(true)
  certificationAlertsEmail Boolean  @default(true)
  certificationAlertsInApp Boolean  @default(true)
  engagementPromptsEmail   Boolean  @default(true)
  engagementPromptsInApp   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime
  enrollmentConfirmEmail   Boolean  @default(true)
  enrollmentConfirmInApp   Boolean  @default(true)
  registrationSetupInApp   Boolean  @default(true)
  users                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model notifications {
  id        String           @id
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime
  users     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}

model quiz_attempts {
  id          String   @id
  quizId      String
  userId      String
  score       Int
  isPassed    Boolean
  answers     Json
  completedAt DateTime @default(now())
  quizzes     quizzes  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  users       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
}

model quiz_options {
  id             String         @id
  questionId     String
  text           String
  isCorrect      Boolean        @default(false)
  position       Int
  quiz_questions quiz_questions @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model quiz_questions {
  id           String         @id
  quizId       String
  text         String
  position     Int
  quiz_options quiz_options[]
  quizzes      quizzes        @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model quizzes {
  id              String           @id
  lessonId        String           @unique
  timeLimit       Int
  passingScore    Int
  attemptsAllowed Int              @default(2)
  questionType    String           @default("Multiple Choice")
  quiz_attempts   quiz_attempts[]
  quiz_questions  quiz_questions[]
  lessons         Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String        @id @default(uuid())
  userId    String
  courseId  String
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  reference String?
  transactionId   String?
  paymentMethod   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("payments")
}

enum Role {
  LEARNER
  INSTRUCTOR
  ADMIN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonKind {
  VIDEO
  DOC
  PDF
  SCREEN
  QUIZ
  ASSESSMENT
}

enum NotificationType {
  COURSE_UPDATE
  ENROLLMENT
  PAYMENT
  SYSTEM
  ANNOUNCEMENT
}

enum PaymentStatus {
  COMPLETED
  FAILED
  PENDING
}